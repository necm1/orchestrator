{
  "name": "@orchestrator/api-orm",
  "version": "0.0.1",
  "private": true,
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./src/index.d.ts",
  "type": "commonjs",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@orchestrator/source": "./src/index.ts",
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "dependencies": {
    "@nestjs/typeorm": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "ioredis": "^5.8.0",
    "pg": "^8.16.3",
    "tslib": "^2.3.0",
    "typeorm": "^0.3.27"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "@nx/js:tsc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "dist/packages/api-orm",
          "tsConfig": "packages/api-orm/tsconfig.lib.json",
          "packageJson": "packages/api-orm/package.json",
          "main": "packages/api-orm/src/index.ts",
          "assets": [
            "packages/api-orm/*.md"
          ]
        }
      }
    }
  },
  "devDependencies": {
    "@types/pg": "^8"
  }
}
