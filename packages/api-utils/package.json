{
  "name": "@orchestrator/api-utils",
  "version": "0.0.1",
  "private": true,
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@orchestrator/source": "./src/index.ts",
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "@nx/js:tsc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "dist/packages/api-utils",
          "tsConfig": "packages/api-utils/tsconfig.lib.json",
          "packageJson": "packages/api-utils/package.json",
          "main": "packages/api-utils/src/index.ts",
          "assets": [
            "packages/api-utils/*.md"
          ]
        }
      }
    }
  },
  "dependencies": {
    "@nestjs/cache-manager": "^3.0.1",
    "@nestjs/common": "^11.1.6",
    "cache-manager": "5.7.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "rxjs": "^7.8.2",
    "tslib": "^2.3.0",
    "typeorm": "^0.3.27"
  }
}
