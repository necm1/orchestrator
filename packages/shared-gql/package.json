{
    "name": "@orchestrator/shared-gql",
    "version": "0.0.1",
    "private": true,
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "@orchestrator/source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "dependencies": {
        "tslib": "^2.3.0"
    },
    "nx": {
        "targets": {
            "build": {
                "executor": "@nx/js:tsc",
                "outputs": [
                    "{options.outputPath}"
                ],
                "options": {
                    "outputPath": "dist/packages/shared-gql",
                    "tsConfig": "packages/shared-gql/tsconfig.lib.json",
                    "packageJson": "packages/shared-gql/package.json",
                    "main": "packages/shared-gql/src/index.ts",
                    "assets": [
                        "packages/shared-gql/*.md"
                    ]
                }
            }
        }
    }
}
