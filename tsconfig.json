{
  "extends": "./tsconfig.base.json",
  "compileOnSave": false,
  "files": [],
  "compilerOptions": {
    "target": "ES2018",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "noImplicitAny": true,
    "lib": ["ES7"],
    "baseUrl": "./",
    "outDir": "./dist",
    "declaration": false
  },
  "ts-node": {
    "require": ["tsconfig-paths/register"]
  },
  "references": [
    {
      "path": "./apps/api"
    },
    {
      "path": "./apps/app"
    },
    {
      "path": "./packages/ui"
    },
    {
      "path": "./packages/flow-editor"
    },
    {
      "path": "./packages/api-utils"
    },
    {
      "path": "./packages/api-orm"
    },
    {
      "path": "./packages/api-auth"
    },
    {
      "path": "./packages/shared"
    },
    {
      "path": "./apps/graphql-api"
    }
  ],
  "exclude": [
    "dist",
    "dist/*",
    "**/dist",
    "**/dist/*",
    "node_modules",
    "node_modules/*",
    "**/node_modules",
    "**/node_modules/*",
    "tmp",
    "tmp/*",
    "**/tmp",
    "**/tmp/*"
  ]
}
