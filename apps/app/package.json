{
  "name": "@orchestrator/app",
  "version": "0.0.1",
  "private": true,
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "next": "~15.2.4",
    "postcss": "^8.5.6",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwindcss": "^4.1.14"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "@nx/next:build",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "dist/apps/app"
        },
        "configurations": {
          "development": {},
          "production": {}
        }
      },
      "dev": {
        "executor": "@nx/next:server",
        "dependsOn": [
          "@orchestrator/shared:types"
        ],
        "options": {
          "buildTarget": "@orchestrator/app:build",
          "turbo": false,
          "experimentalHttps": false
        }
      }
    }
  }
}
